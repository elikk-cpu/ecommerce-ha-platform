global
    log /dev/log local0
    log /dev/log local1 notice
    chroot /var/lib/haproxy
    stats socket /run/haproxy/admin.sock mode 660 level admin
    stats timeout 30s
    user haproxy
    group haproxy
    daemon

defaults
    log global
    mode http
    option httplog
    option dontlognull

    timeout connect 5s
    timeout client  50s
    timeout server  50s

frontend ecommerce_frontend
    bind *:{{ haproxy_frontend_port }}
    default_backend ecommerce_apps

backend ecommerce_apps
    balance roundrobin
    option httpchk GET /health
    http-check expect status 200

{% for backend in haproxy_backends %}
    server {{ backend.name }} {{ backend.address }}:{{ backend.port }} check inter 2s fall 3 rise 2
{% endfor %}
