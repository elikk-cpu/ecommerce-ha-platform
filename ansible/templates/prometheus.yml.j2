global:
  scrape_interval: 15s
  evaluation_interval: 15s

rule_files:
  - /etc/prometheus/rules/*.yml

alerting:
  alertmanagers:
    - static_configs:
        - targets:
            - "127.0.0.1:9093"

scrape_configs:
  - job_name: "prometheus"
    static_configs:
      - targets:
          - "127.0.0.1:9090"
        labels:
          instance: "monitor"
          component: "prometheus"

  - job_name: "node_exporter"
    static_configs:
{% for host in groups['all'] %}
      - targets:
          - "{{ hostvars[host].ansible_host | default(host) }}:9100"
        labels:
          instance: "{{ host }}"
          component: "node"
{% endfor %}

  - job_name: "fastapi"
    metrics_path: "/metrics"

    static_configs:
{% for host in groups['apps'] %}
      - targets:
          - "{{ hostvars[host].ansible_host }}:9101"
        labels:
          instance: "{{ host }}"
          component: "application"
{% endfor %}

  - job_name: "postgresql"

    static_configs:
{% for host in groups['databases'] %}
      - targets:
          - "{{ hostvars[host].ansible_host }}:9187"
        labels:
          instance: "{{ host }}"
          component: "postgresql"
{% endfor %}

  - job_name: "redis"

    static_configs:
{% for host in groups['redis'] %}
      - targets:
          - "{{ hostvars[host].ansible_host }}:9121"
        labels:
          instance: "{{ host }}"
          component: "redis"
{% endfor %}

  - job_name: "rabbitmq"

    static_configs:
{% for host in groups['rabbitmq'] %}
      - targets:
          - "{{ hostvars[host].ansible_host }}:15692"
        labels:
          instance: "{{ host }}"
          component: "rabbitmq"
{% endfor %}
